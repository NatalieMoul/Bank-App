{
  "expo": {
    "name": "Bank App",
    "slug": "bank-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4B3FE4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes for transfers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4B3FE4"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "This app uses the camera to scan QR codes for transfers."
        }
      ],
      "expo-status-bar"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
